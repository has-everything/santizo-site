---
// Every page: <head> (title, description, link previews, structured data,
// icons), fonts, theme, analytics, and the site script.
import '../styles/global.css';
import { site } from '../data/site';
import { abs, defaultImage, jsonLd, type OgImage } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Link preview image, 1200x630 (defaults to the santizo card) */
  image?: OgImage;
  /** Structured data nodes for this page (see src/lib/seo.ts) */
  schema?: object[];
  /** Keep this page out of search even after launch (404) */
  noindex?: boolean;
}
const { title = site.title, description = site.description, image = defaultImage, schema = [], noindex = false } = Astro.props;
const url = abs(Astro.url.pathname);
const indexable = site.indexable && !noindex;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content={site.person}>
  {indexable ? <link rel="canonical" href={url}> : <meta name="robots" content="noindex, nofollow">}

  <!-- Link previews (Open Graph, X/Twitter) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content={url}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={abs(image.src)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={image.alt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={abs(image.src)}>
  <meta name="twitter:image:alt" content={image.alt}>

  {schema.length > 0 && <script type="application/ld+json" set:html={jsonLd(schema)} />}

  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">

  <!-- Theme before first paint: ?theme=night in the URL, else the saved choice, else day -->
  <script is:inline>
    (function () {
      var t = null;
      try { t = new URLSearchParams(location.search).get('theme') || localStorage.getItem('santizo-theme'); } catch (e) {}
      if (t === 'night' || t === 'dark') document.documentElement.dataset.theme = 'night';
    })();
  </script>

  {import.meta.env.PROD && (
    <>
      <!-- Vercel Web Analytics: enable it in the Vercel project (Analytics tab) -->
      <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
      <script is:inline defer src="/_vercel/insights/script.js"></script>
    </>
  )}
</head>
<body>
  <slot />
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
