---
// Burning Man: the owner's photographs from Black Rock City (SantizoOS's
// burning_man_pics), one after another, all at the same width (the column,
// up to 1200px), so nothing needs a click to be seen. The list lives in src/data/photos.ts.
// /photos redirects here (astro.config.mjs).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import { burningMan } from '../data/photos';
import { site } from '../data/site';
import { abs, author, breadcrumbs } from '../lib/seo';

const { photos } = burningMan;

const description = 'Burning Man photographs by Hector Augusto Santizo: a visual journey captured over five years in the Black Rock Desert of northern Nevada.';
const image = { src: '/img/og/burning-man.jpg', alt: 'A giant metal flower sculpture on the playa at Burning Man, with a person reaching up toward it' };
const schema = [
  {
    '@type': 'ImageGallery',
    name: 'Burning Man',
    description,
    url: abs('/burning-man'),
    author: author(),
    image: photos.map((ph) => ({
      '@type': 'ImageObject',
      contentUrl: abs(ph.src),
      caption: ph.alt,
      width: ph.w,
      height: ph.h,
      creator: author(),
      creditText: site.person,
    })),
  },
  breadcrumbs([['Burning Man', '/burning-man']]),
];
---
<Base title="Burning Man · Santizo" description={description} image={image} schema={schema}>
  <Header />

  <Section label={burningMan.title} space="sm">
    <h1>{burningMan.title}</h1>
    <p class="lead">{burningMan.lead}</p>
    <p class="body muted">{burningMan.body}</p>
  </Section>

  <Section label="Photographs" space="md">
    <SectionHead num="01" title="Photographs" aside={String(photos.length).padStart(2, '0')} />
    <div class="stack">
      {photos.map((ph, i) => (
        <img class="rv" src={ph.src} alt={ph.alt} width={ph.w} height={ph.h} style={`--ar: ${(ph.w / ph.h).toFixed(4)}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
      ))}
    </div>
  </Section>

  <Footer num="02" />
</Base>

<style>
  h1 { margin: 0 0 clamp(24px, 3vw, 40px); font-size: clamp(56px, 8.4vw, 136px); line-height: .9; letter-spacing: -0.05em; font-weight: 500; }
  .lead { margin: 0; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; max-width: 30ch; }
  .body { margin: 20px 0 0; font-size: 17px; line-height: 1.6; max-width: 52ch; }

  /* One photo per row, centered, every photo the same width: the column, up
     to 1200px (the photos' real width, so none are upscaled). Height follows
     each photo's shape (--ar), which also reserves its space before it loads
     so the page doesn't jump while scrolling. */
  .stack { display: flex; flex-direction: column; align-items: center; gap: clamp(32px, 6vw, 96px); }
  /* Slightly rounded corners: 4px on phones up to 8px on wide screens */
  .stack img { display: block; width: min(100%, 1200px); height: auto; aspect-ratio: var(--ar); background: var(--raised); border-radius: clamp(4px, .6vw, 8px); }
</style>
