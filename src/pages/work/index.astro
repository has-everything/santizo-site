---
// Work: every project, in three groups. Each tile opens /work/<slug>. The XR
// group opens with the intro that was the XR page's (/xr redirects here, to #xr).
// Projects and their order live in src/data/work.ts.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkTile from '../../components/WorkTile.astro';
import SpecList from '../../components/project/SpecList.astro';
import { projects, groups, tile, toylineTile, spaceTile, recordsTile, xrIntro } from '../../data/work';
import { abs, author, breadcrumbs } from '../../lib/seo';

const motion = projects.filter((p) => p.group === 'motion').map((p) => tile(p));
// HAS Toyline, HAS Records and HAS Space have their own pages (no Vimeo film), so their tiles are added here, around Van Gogh · The Bedroom
const interactive = [toylineTile, recordsTile, ...projects.filter((p) => p.group === 'interactive').map((p) => tile(p)), spaceTile];
const xr = projects.filter((p) => p.group === 'xr');
const count = (n: number) => String(n).padStart(2, '0');

const description = 'Motion, real-time and XR work by Hector Augusto Santizo, creative technologist in Los Angeles.';
const schema = [
  { '@type': 'CollectionPage', name: 'Work', description, url: abs('/work'), author: author() },
  breadcrumbs([['Work', '/work']]),
];
---
<Base title="Work · Santizo" description={description} schema={schema}>
  <Header />

  <Section label="Work" space="sm">
    <h1>Work</h1>
    <p class="lead">Motion, real-time and XR. Every piece plays right here, with sound.</p>
  </Section>

  <Section id="motion" label={groups.motion.label} space="md">
    <SectionHead num={groups.motion.num} title={groups.motion.label} aside={count(motion.length)} />
    <div class="grid-2">
      {motion.map((t) => <WorkTile item={t} size="cell" />)}
    </div>
  </Section>

  <Section id="interactive" label={groups.interactive.label} space="md">
    <SectionHead num={groups.interactive.num} title={groups.interactive.label} aside={count(interactive.length)} />
    <div class="grid-2">
      {interactive.map((t) => <WorkTile item={t} size="cell" />)}
    </div>
  </Section>

  <Section id="xr" label={groups.xr.label}>
    <SectionHead num={groups.xr.num} title={groups.xr.label} aside={count(xr.length)} />
    <div class="xr-about">
      <p class="xr-lead">{xrIntro.lead}</p>
      <div class="xr-side">
        <p class="muted">{xrIntro.body}</p>
        <SpecList specs={[
          ['Covers', xrIntro.covers],
          ['Tools', xrIntro.tools],
        ]} />
      </div>
    </div>
    <div class="grid-2">
      {xr.map((p) => <WorkTile item={tile(p)} size="cell" />)}
    </div>
  </Section>

  <Footer num="04" />
</Base>

<style>
  h1 { margin: 0 0 clamp(24px, 3vw, 40px); font-size: clamp(56px, 8.4vw, 136px); line-height: .9; letter-spacing: -0.05em; font-weight: 500; }
  .lead { margin: 0; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; max-width: 26ch; }

  /* The XR intro, as it was on the XR page: the lead, then the why and the tools */
  .xr-about { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 24px; margin-bottom: 64px; }
  .xr-lead { flex: 3 1 520px; min-width: 0; margin: 0; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; max-width: 24ch; }
  .xr-side { flex: 2 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .xr-side p { margin: 0; font-size: 17px; line-height: 1.6; }
</style>
