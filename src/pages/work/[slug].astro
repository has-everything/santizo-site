---
// One page per project in src/data/work.ts: the video (plays here, with
// sound), what it is, the owner's case study when there is one, and three
// related projects. `tagline`, `year` and `story` show only when set.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import SpecList from '../../components/project/SpecList.astro';
import Related from '../../components/project/Related.astro';
import Story from '../../components/project/Story.astro';
import { projects, groups, type Project } from '../../data/work';
import { related, nextThree } from '../../data/related';
import { abs, author, breadcrumbs } from '../../lib/seo';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

interface Props { p: Project }
const { p } = Astro.props;
const group = groups[p.group];

const specs: [string, string][] = [
  ['Category', group.label],
  ['Focus', p.focus.join(' · ')],
  ...(p.year ? [['Year', p.year] as [string, string]] : []),
];

const path = `/work/${p.slug}`;
// Related: three picked in src/data/related.ts (else the next three in its group)
const more = related(path, nextThree(projects.filter((x) => x.group === p.group).map((x) => `/work/${x.slug}`), path));
const description = `${p.title}: ${(p.tagline ?? p.blurb).replace(/\.$/, '')}. ${group.label} by Hector Augusto Santizo, 3D motion designer in Los Angeles.`;
const schema = [
  {
    '@type': 'CreativeWork',
    name: p.title,
    description,
    url: abs(path),
    genre: group.label,
    keywords: p.focus.join(', '),
    ...(p.year && { dateCreated: p.year }),
    author: author(),
  },
  breadcrumbs([['Work', '/work'], [p.title, path]]),
];
---
<Base title={`${p.title} · Santizo`} description={description} schema={schema}>
  <Header />

  <div class="crumbs">
    <a href="/work" class="mono cap hl hl-44">← All work</a>
    <span class="mono cap muted">Work / {group.label}</span>
  </div>

  <section aria-label="Video" class="screen">
    <div class="fit"><VideoPlayer video={p.video} title={p.title} /></div>
  </section>

  <Section label="Overview" space="sm">
    <div class="overview">
      <div class="name">
        <h1>{p.title}</h1>
        <p class="muted">{p.tagline ?? p.blurb}</p>
      </div>
      <div class="facts">
        <SpecList specs={specs} />
      </div>
    </div>
  </Section>

  {p.story && (
    <Section label="About the project" space="md">
      <Story blocks={p.story} />
    </Section>
  )}

  <Related items={more} num="01" />

  <Footer num="02" />
</Base>

<style>
  /* The video runs edge to edge on a black band, sized so the whole player
     fits on screen under the top bar and the crumbs */
  .screen { background: #000000; }
  .fit { margin: 0 auto; width: min(100%, calc((100vh - 168px) * 16 / 9)); width: min(100%, calc((100svh - 168px) * 16 / 9)); }
  .crumbs { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 24px var(--gutter) 16px; }

  .overview { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 24px; }
  .name { flex: 3 1 520px; min-width: 0; }
  h1 { margin: 0; font-size: clamp(44px, 6.4vw, 104px); line-height: .95; letter-spacing: -0.045em; font-weight: 500; }
  .name p { margin: 16px 0 0; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.15; letter-spacing: -0.02em; font-weight: 500; }
  .facts { flex: 2 1 340px; min-width: 0; }

</style>
