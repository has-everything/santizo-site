---
// HAS Records: a one-off work page (see `records` in src/data/work.ts), built
// like HAS Toyline's, but its video plays in the Vimeo player, with sound and
// controls, as on the other work pages; the role first in the specs, the case study, the figures, six "What it does"
// cards and three related pages.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import NumberedGrid from '../../components/NumberedGrid.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import SpecList from '../../components/project/SpecList.astro';
import Figure from '../../components/project/Figure.astro';
import Related from '../../components/project/Related.astro';
import Story from '../../components/project/Story.astro';
import { records as p, groups } from '../../data/work';
import { related } from '../../data/related';
import { abs, author, breadcrumbs } from '../../lib/seo';

const group = groups[p.group];

const specs: [string, string][] = [
  ['Role', p.role],
  ['Category', group.label],
  ['Focus', p.focus.join(' · ')],
  ['Runs on', p.runsOn],
  ['Year', p.year],
];

const path = `/work/${p.slug}`;
const description = `${p.title}: ${p.tagline} A Rega Planar 6 RS in Unreal Engine, by Hector Augusto Santizo, creative technologist in Los Angeles.`;
const schema = [
  {
    '@type': 'CreativeWork',
    name: p.title,
    description,
    url: abs(path),
    genre: group.label,
    keywords: p.focus.join(', '),
    dateCreated: p.year,
    image: abs(p.og.src),
    author: author(),
  },
  breadcrumbs([['Work', '/work'], [p.title, path]]),
];
---
<Base title={`${p.title} · Santizo`} description={description} image={p.og} schema={schema}>
  <Header />

  <div class="crumbs">
    <a href="/work" class="mono cap hl hl-44">← All work</a>
    <span class="mono cap muted">Work / {group.label}</span>
  </div>

  <section aria-label="Video" class="screen">
    <div class="fit"><VideoPlayer video={p.video} title={p.title} /></div>
  </section>

  <Section label="Overview" space="sm">
    <div class="overview">
      <div class="name">
        <h1>{p.title}</h1>
        <p class="muted">{p.tagline}</p>
      </div>
      <div class="facts">
        <SpecList specs={specs} />
      </div>
    </div>
  </Section>

  <Section label="About the project" space="md">
    <Story blocks={p.story} />
  </Section>

  <Section label="Close up" space="md">
    <div class="pair">
      {p.squares.map((s, i) => (
        <Figure num={String(i + 1).padStart(2, '0')} caption={s.caption} ratio="1 / 1" half>
          <img class="fill" src={s.src} width={s.w} height={s.h} loading="lazy" decoding="async" alt={s.alt} />
        </Figure>
      ))}
    </div>
  </Section>

  <Section label="The Blender source" space="md">
    <Figure num="03" caption={p.model.caption}>
      <img class="fill" src={p.model.src} width={p.model.w} height={p.model.h} loading="lazy" decoding="async" alt={p.model.alt} />
    </Figure>
  </Section>

  <Section label="What it does">
    <SectionHead num="01" title="What it does" aside={String(p.features.length).padStart(2, '0')} />
    <NumberedGrid items={p.features} narrow />
  </Section>

  <Section label="At the turntable" space="md">
    <div class="pair">
      {p.pair.map((s, i) => (
        <Figure num={String(i + 4).padStart(2, '0')} caption={s.caption} half>
          <img class="fill" src={s.src} width={s.w} height={s.h} loading="lazy" decoding="async" alt={s.alt} />
        </Figure>
      ))}
    </div>
  </Section>

  <Section label="The listening room" space="md">
    <Figure num="06" caption={p.app.caption}>
      <img class="fill" src={p.app.src} width={p.app.w} height={p.app.h} loading="lazy" decoding="async" alt={p.app.alt} />
    </Figure>
  </Section>

  <Section label="Exploded view" space="lg">
    <Figure num="07" caption={p.exploded.caption}>
      <img class="fill" src={p.exploded.src} width={p.exploded.w} height={p.exploded.h} loading="lazy" decoding="async" alt={p.exploded.alt} />
    </Figure>
  </Section>

  <Related items={related(path, [])} num="02" />

  <Footer num="03" />
</Base>

<style>
  /* As on the other work pages: the video edge to edge on a black band, sized to
     fit on screen under the top bar and the crumbs */
  .screen { background: #000000; }
  .fit { margin: 0 auto; width: min(100%, calc((100vh - 168px) * 16 / 9)); width: min(100%, calc((100svh - 168px) * 16 / 9)); }
  .crumbs { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 24px var(--gutter) 16px; }

  .overview { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 24px; }
  .name { flex: 3 1 520px; min-width: 0; }
  h1 { margin: 0; font-size: clamp(44px, 6.4vw, 104px); line-height: .95; letter-spacing: -0.045em; font-weight: 500; }
  .name p { margin: 16px 0 0; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.15; letter-spacing: -0.02em; font-weight: 500; }
  .facts { flex: 2 1 340px; min-width: 0; }

  .pair { display: flex; flex-wrap: wrap; gap: 48px var(--tile-gap); }
</style>
