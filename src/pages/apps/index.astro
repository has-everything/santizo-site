---
// Apps: nine of the free tools from has.tools, as a grid of preview cards.
// Pick and order them in src/data/apps.ts.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkTile from '../../components/WorkTile.astro';
import PillLink from '../../components/project/PillLink.astro';
import { tools } from '../../data/apps';

const count = String(tools.length).padStart(2, '0');
---
<Base title="Apps · Santizo" description="Free creative tools by Hector Augusto Santizo for motion designers, 3D artists and creative coders. They run in the browser.">
  <Header />

  <Section label="Apps" space="sm">
    <h1>Apps</h1>
    <div class="intro">
      <p class="lead">Free creative tools for motion designers, 3D artists and creative coders. They all run in the browser, with nothing to install.</p>
      <div class="cta">
        <PillLink href="https://has.tools">Visit has.tools ↗</PillLink>
      </div>
    </div>
  </Section>

  <Section label="All apps" space="md">
    <SectionHead num="01" title="The tools" aside={count} />
    <div class="grid">
      {tools.map((t) => <WorkTile item={t} size="cell" ratio="16 / 10" />)}
    </div>
  </Section>

  <Footer num="02" tools={[
    { label: 'has.tools ↗', href: 'https://has.tools' },
    { label: 'All work', href: '/#work' },
  ]} />
</Base>

<style>
  h1 { margin: 0 0 clamp(40px, 5vw, 72px); font-size: clamp(56px, 8.4vw, 136px); line-height: .9; letter-spacing: -0.05em; font-weight: 500; }
  .intro { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px 24px; }
  .lead { flex: 1 1 520px; min-width: 0; margin: 0; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; max-width: 30ch; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 56px 24px; }
</style>
