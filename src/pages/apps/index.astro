---
// Apps: why the tools exist, then five of them from has.tools, each with the
// problem it answers: the first full width, the rest two per row. Copy and
// order live in src/data/apps.ts.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkTile from '../../components/WorkTile.astro';
import PillLink from '../../components/project/PillLink.astro';
import { tools, appsIntro } from '../../data/apps';
import { abs, author, breadcrumbs } from '../../lib/seo';

const [first, ...rest] = tools;
const count = String(tools.length).padStart(2, '0');

const description = 'Free creative tools by Hector Augusto Santizo for motion designers, 3D artists and creative coders. They run in the browser.';
const schema = [
  { '@type': 'CollectionPage', name: 'Apps', description, url: abs('/apps'), author: author() },
  breadcrumbs([['Apps', '/apps']]),
];
---
<Base title="Apps · Santizo" description={description} schema={schema}>
  <Header />

  <Section label="Why these apps exist" space="sm">
    <h1>Apps</h1>
    <div class="intro">
      <p class="lead">{appsIntro.lead}</p>
      <div class="side">
        <p>{appsIntro.body}</p>
        <p class="muted">{appsIntro.aside}</p>
        <div><PillLink href="https://has.tools">Visit has.tools ↗</PillLink></div>
      </div>
    </div>
  </Section>

  <Section label="All apps" space="md">
    <SectionHead num="01" title="The tools" aside={count} />
    <div class="apps">
      <WorkTile item={first} size="full" />
      <div class="grid-2">
        {rest.map((t) => <WorkTile item={t} size="cell" />)}
      </div>
    </div>
  </Section>

  <Footer num="02" tools={[
    { label: 'has.tools ↗', href: 'https://has.tools' },
    { label: 'All work', href: '/#work' },
  ]} />
</Base>

<style>
  h1 { margin: 0 0 clamp(40px, 5vw, 72px); font-size: clamp(56px, 8.4vw, 136px); line-height: .9; letter-spacing: -0.05em; font-weight: 500; }
  .intro { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 24px; }
  .lead { flex: 3 1 520px; min-width: 0; margin: 0; font-size: clamp(28px, 3.4vw, 52px); line-height: 1.06; letter-spacing: -0.03em; font-weight: 500; max-width: 18ch; }
  .side { flex: 2 1 340px; min-width: 0; max-width: 52ch; display: flex; flex-direction: column; gap: 18px; }
  .side p { margin: 0; font-size: 17px; line-height: 1.6; }
  .apps { display: flex; flex-direction: column; gap: 56px; }
</style>
