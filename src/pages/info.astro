---
// Info: who, where, what I do (the expertise grid lives here, not on home),
// and the manifesto.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedGrid from '../components/NumberedGrid.astro';
import SpecList from '../components/project/SpecList.astro';
import { site, intro, info, manifesto } from '../data/site';
import { expertise } from '../data/expertise';
import { abs, person, breadcrumbs } from '../lib/seo';

const description = 'About Hector Augusto Santizo, 3D motion designer and creative technologist in Los Angeles: background, expertise and the five rules behind the work.';
const schema = [
  { '@type': 'ProfilePage', name: 'Info', description, url: abs('/info'), mainEntity: person() },
  breadcrumbs([['Info', '/info']]),
];
---
<Base title="Info · Santizo" description={description} schema={schema}>
  <Header />

  <Section label="Info" space="sm">
    <h1>Info</h1>
    <div class="about">
      <p class="lead">{info.lead}</p>
      <div class="side">
        <p class="muted">{intro.body}</p>
        <SpecList specs={[
          ['Based in', site.region],
          ['Experience', expertise.aside],
          ['Email', site.email],
        ]} />
      </div>
    </div>
  </Section>

  <Section id="expertise" label="Expertise">
    <SectionHead num="01" title="Expertise" aside={expertise.aside} />
    <NumberedGrid items={expertise.items} />
  </Section>

  <Section id="manifesto" label="Manifesto">
    <SectionHead num="02" title="Manifesto" />
    <ol class="manifesto">
      {manifesto.map((line, i) => (
        <li><span class="mono cap-sm muted">{String(i + 1).padStart(2, '0')}</span><span>{line}</span></li>
      ))}
    </ol>
    <a href="/burning-man" class="hl photos">Also: five years of playa dust. See the Burning Man photos →</a>
  </Section>

  <Footer num="03" />
</Base>

<style>
  h1 { margin: 0 0 clamp(40px, 5vw, 72px); font-size: clamp(56px, 8.4vw, 136px); line-height: .9; letter-spacing: -0.05em; font-weight: 500; }
  .about { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 24px; }
  .lead { flex: 3 1 520px; min-width: 0; margin: 0; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; max-width: 26ch; }
  .side { flex: 2 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .side p { margin: 0; font-size: 17px; line-height: 1.6; }
  .manifesto { margin: 0; padding: 0; list-style: none; }
  .manifesto li { display: flex; align-items: baseline; gap: 24px; padding: 18px 0; border-top: 1px solid var(--rule); font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; }
  .manifesto li:last-child { border-bottom: 1px solid var(--rule); }
  .manifesto .mono { flex: 0 0 auto; min-width: 2.5em; }
  .photos { display: inline-flex; align-items: center; min-height: 44px; margin-top: 32px; font-size: 15px; }
</style>
