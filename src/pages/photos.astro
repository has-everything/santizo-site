---
// Photos: the Burning Man set, in justified rows that keep each photo's shape.
// Click a photo to view it full screen (src/scripts/lightbox.ts). The list
// lives in src/data/photos.ts.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import { burningMan } from '../data/photos';

const { photos } = burningMan;
---
<Base title="Photos · Santizo" description="Burning Man photographs by Hector Augusto Santizo. Black Rock City, five years of dust and light.">
  <Header />

  <Section label="Photos" space="sm">
    <h1>Photos</h1>
    <p class="lead">{burningMan.lead}</p>
  </Section>

  <Section label={burningMan.title} space="md">
    <SectionHead num="01" title={burningMan.title} aside={String(photos.length).padStart(2, '0')} />
    <div class="gallery" data-gallery>
      {photos.map((ph, i) => (
        <a href={ph.src} style={`--ar: ${(ph.w / ph.h).toFixed(4)}`}>
          <img src={ph.src} alt={ph.alt} width={ph.w} height={ph.h} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
        </a>
      ))}
    </div>
  </Section>

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <img alt="" />
    <p class="mono cap count" aria-live="polite"></p>
    <button type="button" class="mono cap close" data-close>Close ×</button>
    <button type="button" class="nav prev" data-prev aria-label="Previous photo">←</button>
    <button type="button" class="nav next" data-next aria-label="Next photo">→</button>
  </dialog>

  <Footer num="02" />
</Base>

<script>
  import '../scripts/lightbox';
</script>

<style>
  h1 { margin: 0 0 clamp(24px, 3vw, 40px); font-size: clamp(56px, 8.4vw, 136px); line-height: .9; letter-spacing: -0.05em; font-weight: 500; }
  .lead { margin: 0; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; max-width: 26ch; }

  /* Justified rows: each photo grows in proportion to its aspect ratio, so a row shares one height */
  .gallery { --row: clamp(170px, 24vw, 340px); display: flex; flex-wrap: wrap; gap: 8px; }
  .gallery::after { content: ""; flex-grow: 1000000; } /* the last row keeps its natural height */
  .gallery a { position: relative; overflow: hidden; background: var(--raised); aspect-ratio: var(--ar); flex-grow: calc(var(--ar) * 100); flex-basis: calc(var(--ar) * var(--row)); }
  .gallery img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s var(--ease); }
  .gallery a:hover img { transform: scale(1.025); }

  /* Full-screen viewer */
  .lightbox { width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #000000; color: #ffffff; }
  .lightbox::backdrop { background: #000000; }
  .lightbox { touch-action: pan-y pinch-zoom; } /* horizontal swipes come to the script, not the browser */
  .lightbox img { position: absolute; top: 72px; bottom: 72px; left: var(--gutter); right: var(--gutter); width: calc(100% - 2 * var(--gutter)); height: calc(100% - 144px); object-fit: contain; }
  .lightbox button { position: absolute; background: none; border: 0; padding: 0; color: #ffffff; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; }
  .lightbox button:hover { color: var(--accent); }
  .close { top: 14px; right: var(--gutter); }
  .count { position: absolute; left: var(--gutter); bottom: 14px; margin: 0; min-height: 44px; display: flex; align-items: center; color: rgba(255, 255, 255, .7); }
  .nav { bottom: 14px; font-size: 22px; }
  .prev { right: calc(var(--gutter) + 56px); }
  .next { right: var(--gutter); }

  @media (prefers-reduced-motion: reduce) { .gallery img { transition: none; } }
</style>
