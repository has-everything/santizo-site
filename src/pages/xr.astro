---
// XR: augmented, virtual and mixed reality. The intro, tools and the order of
// the clips live in xrPage in src/data/work.ts: the first clip runs full
// width, the rest two per row. Every clip opens its page under /work.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import SpecList from '../components/project/SpecList.astro';
import WorkTile from '../components/WorkTile.astro';
import { xrPage } from '../data/work';
import { abs, author, breadcrumbs } from '../lib/seo';

const [first, ...rest] = xrPage.projects;
const count = String(xrPage.projects.length).padStart(2, '0');

const description = 'XR by Hector Augusto Santizo: augmented, virtual and mixed reality prototypes, with your hands as the controller. Built in Unity, Unreal Engine and code.';
const schema = [
  { '@type': 'CollectionPage', name: 'XR', description, url: abs('/xr'), author: author() },
  breadcrumbs([['XR', '/xr']]),
];
---
<Base title="XR · Santizo" description={description} schema={schema}>
  <Header />

  <Section label="XR" space="sm">
    <h1>XR</h1>
    <div class="about">
      <p class="lead">{xrPage.lead}</p>
      <div class="side">
        <p class="muted">{xrPage.body}</p>
        <SpecList specs={[
          ['Covers', xrPage.covers],
          ['Tools', xrPage.tools],
        ]} />
      </div>
    </div>
  </Section>

  <Section id="projects" label="XR projects" space="md">
    <SectionHead num="01" title="Projects" aside={count} />
    <div class="clips">
      <WorkTile item={first} size="full" />
      <div class="grid-2">
        {rest.map((item) => <WorkTile item={item} size="cell" />)}
      </div>
    </div>
  </Section>

  <Footer num="02" />
</Base>

<style>
  h1 { margin: 0 0 clamp(40px, 5vw, 72px); font-size: clamp(56px, 8.4vw, 136px); line-height: .9; letter-spacing: -0.05em; font-weight: 500; }
  .about { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px 24px; }
  .lead { flex: 3 1 520px; min-width: 0; margin: 0; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 500; max-width: 24ch; }
  .side { flex: 2 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .side p { margin: 0; font-size: 17px; line-height: 1.6; }
  .clips { display: flex; flex-direction: column; gap: 56px; }
</style>
