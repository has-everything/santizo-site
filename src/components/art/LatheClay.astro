---
// HAS Lathe still (1:1): the vessel as a solid clay silhouette.
import { RINGS, STEP, side, pathD } from '../../lib/lathe';

const cx = 400;
const top = 220;
const right = side(cx, top, 1);
const left = side(cx, top, -1).reverse();
const outline = pathD([...right, ...left]) + ' Z';
// Contour arcs across the front of the body
const arcs = [7, 11, 15].map((i) => {
  const [rx, ry] = RINGS[i];
  const y = top + i * STEP;
  return `M${cx - rx} ${y} A${rx} ${ry} 0 0 0 ${cx + rx} ${y}`;
});
---
<svg class="fill" viewBox="0 0 800 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <ellipse class="shade" cx={cx} cy="784" rx="210" ry="20" />
  <path class="solid" d={outline} />
  {arcs.map((d) => <path class="ln" d={d} />)}
  <ellipse class="hole" cx={cx} cy={top} rx={RINGS[0][0]} ry={RINGS[0][1]} />
  <line class="lnS" x1="40" y1="784" x2="760" y2="784" />
</svg>
