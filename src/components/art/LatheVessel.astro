---
// Wireframe vessel (rings + both profile lines) as an SVG <g>, swaying.
// Use inside an <svg>.
import { rings, side, pathD, LAST } from '../../lib/lathe';

interface Props {
  cx: number;
  top?: number;
  motion?: 'sway' | 'swayS';
}
const { cx, top = 170, motion = 'sway' } = Astro.props;

const rs = rings(cx, top);
---
<g class={`fb ${motion}`}>
  {rs.map((r, i) => (
    <ellipse class={i === 0 ? 'lnA' : i === LAST ? 'ln2' : 'ln'} cx={r.cx} cy={r.cy} rx={r.rx} ry={r.ry} />
  ))}
  <path class="ln2" d={pathD(side(cx, top, 1))} />
  <path class="ln2" d={pathD(side(cx, top, -1))} />
</g>
