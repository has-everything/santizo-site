---
// HAS Lathe demo frame (16:9): the profile editor panel on the left, the
// revolved vessel on the right.
import LatheVessel from './LatheVessel.astro';
import { side, WIDEST, HANDLES, LAST } from '../../lib/lathe';

const axis = 200;
// The editor shows the right-hand profile at 1.6x, measured from its own axis.
const pts = side(axis, 170, 1, 1.6);
const belly = pts[WIDEST];
---
<svg class="fill" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect class="panel" x="80" y="80" width="620" height="740" />
  <line class="lnS" x1="80" y1="124" x2="700" y2="124" />
  <rect class="ln" x="104" y="96" width="22" height="14" />
  <rect class="ln" x="134" y="96" width="22" height="14" />
  <rect class="lnA" x="164" y="96" width="22" height="14" />
  <line class="ln dash" x1={axis} y1="150" x2={axis} y2="790" />
  <polyline class="ln2" points={pts.map((p) => p.join(',')).join(' ')} />
  <line class="ln" x1={axis} y1={pts[0][1]} x2={pts[0][0]} y2={pts[0][1]} />
  <line class="ln" x1={axis} y1={pts[LAST][1]} x2={pts[LAST][0]} y2={pts[LAST][1]} />
  <line class="ln2 dash" x1={belly[0]} y1={belly[1] - 58} x2={belly[0]} y2={belly[1] + 58} />
  {HANDLES.map((i) => <circle class="node" cx={pts[i][0]} cy={pts[i][1]} r="6" />)}
  <circle class="ln2 fb pulse" cx={belly[0]} cy={belly[1]} r="24" />
  <circle class="nodeA" cx={belly[0]} cy={belly[1]} r="7" />
  <LatheVessel cx={1180} />
  <line class="lnS" x1="900" y1="760" x2="1460" y2="760" />
</svg>
