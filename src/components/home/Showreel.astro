---
// Full-screen reel. "Play reel" plays it with sound right here (see
// src/scripts/reel.ts); without JavaScript it links to the reel on Vimeo.
import { reel } from '../../data/site';
import Media from '../Media.astro';
---
<section id="top" aria-label="Showreel" class="reel-hero" data-reel={reel.vimeo}>
  <Media media={{ vimeo: reel.vimeo }} title={reel.title} zoom={false} />
  <div class="shade-top" aria-hidden="true"></div>

  <div class="bar">
    <div>
      <p class="title">{reel.title}</p>
      <p class="mono cap credits">{reel.credits}</p>
    </div>
    <a class="reel" href={reel.href} data-reel-toggle>
      <i aria-hidden="true"><b></b><b></b><b></b></i><span>Play reel</span>
    </a>
  </div>
  <button type="button" class="close mono cap" data-reel-close hidden>Close reel ×</button>
  <span class="cue" aria-hidden="true"></span>
</section>

<script>
  import '../../scripts/reel';
</script>

<style>
  .reel-hero { position: relative; height: 100vh; height: 100svh; min-height: 520px; background: #000000; overflow: hidden; }
  .shade-top { position: absolute; top: 0; left: 0; right: 0; height: 200px; background: linear-gradient(to bottom, rgba(0, 0, 0, .55), rgba(0, 0, 0, 0)); }

  .bar {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px;
    padding: 160px var(--gutter) 28px; color: #ffffff;
    background: linear-gradient(to top, rgba(0, 0, 0, .6), rgba(0, 0, 0, 0));
  }
  .title { margin: 0; font-size: clamp(22px, 2.2vw, 30px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; }
  .credits { margin: 8px 0 0; color: rgba(255, 255, 255, .7); }

  /* Play reel: orange dot with a play triangle; sound bars while it plays with sound */
  .reel { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 15px; }
  .reel:hover span { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .reel i { width: 30px; height: 30px; border-radius: 50%; background: var(--accent); display: inline-flex; align-items: center; justify-content: center; gap: 2px; }
  .reel i::after { content: ""; border-left: 8px solid #0b0b0c; border-top: 5px solid transparent; border-bottom: 5px solid transparent; margin-left: 2px; }
  .reel b { display: none; width: 2px; height: 10px; background: #0b0b0c; }
  .sound .reel i::after { display: none; }
  .sound .reel b { display: block; animation: eq .8s ease-in-out infinite alternate; }
  .sound .reel b:nth-child(2) { animation-delay: -.3s; }
  .sound .reel b:nth-child(3) { animation-delay: -.55s; }
  @keyframes eq { from { transform: scaleY(.3); } to { transform: scaleY(1); } }

  /* Fallback when the browser blocks sound: Vimeo's own player, whole frame visible */
  .player :global(.vf iframe) { pointer-events: auto; width: 100%; height: 100%; }
  .player .bar, .player .cue, .player .shade-top { display: none; }
  .close {
    position: absolute; top: 84px; right: var(--gutter); z-index: 2;
    display: inline-flex; align-items: center; min-height: 44px;
    background: none; border: 0; padding: 0; color: #ffffff; cursor: pointer;
  }
  .close[hidden] { display: none; }
  .close:hover { text-decoration: underline; text-underline-offset: 5px; }

  /* Scroll cue */
  .cue { position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); width: 1px; height: 44px; background: rgba(255, 255, 255, .35); overflow: hidden; }
  .cue::after { content: ""; position: absolute; left: 0; top: -44px; width: 1px; height: 44px; background: #ffffff; animation: cue 2.4s cubic-bezier(.6, 0, .2, 1) infinite; }
  @keyframes cue { to { top: 44px; } }
  @media (max-width: 760px) { .cue { display: none; } }
  @media (prefers-reduced-motion: reduce) { .cue::after, .sound .reel b { animation: none; } }
</style>
