---
// (02) XR and interaction: a statement and a strip of portrait clips.
import { xr } from '../../data/work';
import SectionHead from '../SectionHead.astro';
import WorkTile from '../WorkTile.astro';

const count = `${String(xr.clips.length).padStart(2, '0')} clips`;
---
<section id="xr" aria-label="XR and interaction" class="band">
  <div class="wrap inner">
    <SectionHead num="02" title="XR and interaction" aside={count} />
    <p class="statement">{xr.statement}</p>
    <div class="strip rv">
      {xr.clips.map((clip) => <WorkTile item={clip} size="card" ratio="4 / 5" reveal={false} />)}
    </div>
  </div>
</section>

<style>
  .band { background: var(--raised); margin-top: var(--space-xl); }
  .inner { padding-top: 96px; padding-bottom: 96px; }
  .statement { margin: 0 0 48px; font-size: clamp(28px, 3vw, 44px); line-height: 1.06; letter-spacing: -0.025em; font-weight: 500; max-width: 22ch; }
  .strip { display: flex; gap: 24px; overflow-x: auto; padding-bottom: 8px; }
</style>
