---
// Fills its (position: relative) parent with a clip or drawing.
// See src/data/media.ts for the three kinds of media.
import type { Media } from '../data/media';
import LatheTile from './art/LatheTile.astro';

interface Props {
  media: Media;
  title: string;
  /** Add the "art" class so a parent .tile zooms it on hover */
  zoom?: boolean;
  /** Load a clip only as it nears the screen (false for a hero, the first thing on screen: the home
   *  reel, the HAS Toyline film). A self-hosted clip then shows its poster as a lazy image and plays
   *  through src/scripts/lazy-video.ts. */
  lazy?: boolean;
}
const { media, title, zoom = true, lazy = true } = Astro.props;

const ART = { lathe: LatheTile };
const vimeoSrc = (id: string) =>
  `https://player.vimeo.com/video/${id}?background=1&autoplay=1&loop=1&muted=1&autopause=0&dnt=1`;
const Art = 'art' in media ? ART[media.art] : null;
const videoType = (src: string) => (/\.webm(\?|$)/.test(src) ? 'video/webm' : 'video/mp4');
---
{'vimeo' in media && (
  <div class:list={['vf', { art: zoom }]}>
    <iframe src={vimeoSrc(media.vimeo)} loading={lazy ? 'lazy' : 'eager'} allow="autoplay; fullscreen; picture-in-picture" title={title} tabindex="-1"></iframe>
  </div>
)}
{'youtube' in media && (
  <div class:list={['vf', { art: zoom }]}>
    <div class="yt"><img src={`https://i.ytimg.com/vi/${media.youtube}/hqdefault.jpg`} alt={`${title} thumbnail`} loading="lazy" decoding="async" /></div>
  </div>
)}
{'video' in media && !lazy && (
  <video class:list={['fill', { art: zoom }]} autoplay muted loop playsinline preload="metadata" poster={media.poster} aria-label={title}>
    <source src={media.video} type={videoType(media.video)} />
  </video>
)}
{'video' in media && lazy && (
  <>
    {media.poster && <img class:list={['fill', { art: zoom }]} src={media.poster} alt="" loading="lazy" decoding="async" />}
    <video class:list={['fill', { art: zoom }]} muted loop playsinline preload="none" aria-label={title} data-lazy-video>
      <source src={media.video} type={videoType(media.video)} />
    </video>
  </>
)}
{'video' in media && lazy && <script>import '../scripts/lazy-video';</script>}
{Art && <Art class={zoom ? 'art' : undefined} />}
{'img' in media && (
  <img class:list={['fill', { art: zoom }]} src={media.img} alt={`${title} screenshot`} loading="lazy" decoding="async" />
)}
